# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Tradier API token (required for live option prices)
# Sign up at https://developer.tradier.com/ for a free sandbox account
TRADIER_TOKEN=your_tradier_api_token_here

# Use Tradier sandbox (true) or live API (false)
TRADIER_SANDBOX=true

# Path to SQLite database file
DATABASE_PATH=thetamax.db

# Starting bankroll for each player (fake dollars)
STARTING_BANKROLL=10000

# Name of the Discord role that can run admin commands
ADMIN_ROLE_NAME=ThetaMax Admin

# Default underlying symbol for games (e.g. SPY, QQQ, SPX)
DEFAULT_UNDERLYING=SPY
